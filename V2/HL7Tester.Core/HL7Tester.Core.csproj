<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- NHapi: bibliothèque utilisée par l'application WinForms existante pour générer les messages HL7 -->
    <PackageReference Include="nhapi" Version="3.2.4" />
    <PackageReference Include="nhapi.base" Version="3.2.3" />
    <!-- Logging abstractions pour permettre l'injection d'ILogger<> depuis l'hôte MAUI/tests -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Firely SDK: modèles et sérialisation FHIR R4 (décision D1) -->
    <PackageReference Include="Hl7.Fhir.R4" Version="6.7.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Allow the unit test project to access internal members (e.g. Hl7NetworkSender field extractors) -->
    <InternalsVisibleTo Include="HL7Tester.Tests" />
  </ItemGroup>

</Project>
