<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:HL7Tester.ViewModels"
             xmlns:converters="clr-namespace:HL7Tester.Converters"
             xmlns:batch="clr-namespace:HL7Tester.Core.Batch;assembly=HL7Tester.Core"
             x:Class="HL7Tester.BatchSendPage"
             Title="Batch Send">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
            <converters:CollectionNotEmptyConverter x:Key="CollectionNotEmptyConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <!-- Scrollable content -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16" Spacing="12">

                <!-- ── Template selector ─────────────────────────────────────── -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Workflow Template" Style="{StaticResource SubHeadline}" />
                        <CollectionView ItemsSource="{Binding Templates}"
                                        SelectionMode="None"
                                        HeightRequest="180">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="batch:BatchWorkflowTemplate">
                                    <Border Padding="10" Margin="0,2"
                                            Style="{StaticResource ClickableListItemBorder}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectTemplateCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Name}"
                                               FontSize="13"
                                               LineBreakMode="TailTruncation" />
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Button Grid.Column="0"
                                    Text="💾 Save"
                                    Command="{Binding SaveTemplateCommand}"
                                    FontSize="13"
                                    Padding="8,4" />
                            <Button Grid.Column="1"
                                    Text="🗑️ Delete"
                                    Command="{Binding DeleteTemplateCommand}"
                                    FontSize="13"
                                    Padding="8,4"
                                    BackgroundColor="#EF4444"
                                    TextColor="White"
                                    IsVisible="{Binding CanDeleteTemplate}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ── Workflow steps ────────────────────────────────────────── -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,*,Auto">
                            <Label Grid.Column="0" Text="Steps" Style="{StaticResource SubHeadline}" VerticalOptions="Center" />
                            <Picker Grid.Column="1"
                                    Title="Message type"
                                    ItemsSource="{Binding AvailableStepTypes}"
                                    SelectedItem="{Binding SelectedNewStepType}"
                                    FontSize="12" />
                            <Button Grid.Column="2" Text="+ Add"
                                    Command="{Binding AddStepCommand}"
                                    FontSize="13"
                                    Padding="8,4" />
                        </Grid>

                        <CollectionView ItemsSource="{Binding Steps}"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:WorkflowStep">
                                    <Border Padding="10" Margin="0,2"
                                            StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#374151}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout Spacing="6">
                                            <!-- Row 1: message type + controls -->
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                <Label Grid.Column="0"
                                                       Text="{Binding MessageType}"
                                                       FontSize="13"
                                                       VerticalOptions="Center"
                                                       LineBreakMode="TailTruncation" />
                                                <Button Grid.Column="1"
                                                       Text="▲"
                                                       FontSize="12"
                                                       Padding="6,2"
                                                       BackgroundColor="Transparent"
                                                       Command="{Binding MoveUpCommand}" />
                                                <Button Grid.Column="2"
                                                       Text="▼"
                                                       FontSize="12"
                                                       Padding="6,2"
                                                       BackgroundColor="Transparent"
                                                       Command="{Binding MoveDownCommand}" />
                                                <Button Grid.Column="3"
                                                       Text="🗑️"
                                                       FontSize="12"
                                                       Padding="6,2"
                                                       BackgroundColor="Transparent"
                                                       Command="{Binding RemoveCommand}" />
                                            </Grid>

                                            <!-- Row 2a: Identity fields (A31) -->
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8"
                                                  IsVisible="{Binding IsIdentityStep, Converter={StaticResource BoolToVis}}">
                                                <Entry Grid.Column="0"
                                                       Text="{Binding GivenName}"
                                                       Placeholder="PID.5.1 Name"
                                                       FontSize="12" />
                                                <Entry Grid.Column="1"
                                                       Text="{Binding FamilyName}"
                                                       Placeholder="PID.5.2 Surname"
                                                       FontSize="12" />
                                            </Grid>

                                            <!-- Row 2b: Location fields (non-A31) -->
                                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8"
                                                  IsVisible="{Binding IsLocationStep, Converter={StaticResource BoolToVis}}">
                                                <Entry Grid.Column="0"
                                                       Text="{Binding Unit}"
                                                       Placeholder="PV1.3.1 Unit"
                                                       FontSize="12" />
                                                <Entry Grid.Column="1"
                                                       Text="{Binding Room}"
                                                       Placeholder="PV1.3.2 Room"
                                                       FontSize="12" />
                                                <Entry Grid.Column="2"
                                                       Text="{Binding Bed}"
                                                       Placeholder="PV1.3.3 Bed"
                                                       FontSize="12" />
                                                <Entry Grid.Column="3"
                                                       Text="{Binding Floor}"
                                                       Placeholder="PV1.3.4 Floor"
                                                       FontSize="12" />
                                            </Grid>

                                            <!-- Row 2c: Merge fields (A18/A40) -->
                                            <Grid ColumnDefinitions="*"
                                                  IsVisible="{Binding IsMergeStep, Converter={StaticResource BoolToVis}}">
                                                <Entry Grid.Column="0"
                                                       Text="{Binding NewPatientId}"
                                                       Placeholder="MRG.1 New Patient ID"
                                                       FontSize="12" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- ── Location fields ───────────────────────────────────────── -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Location (applied to all steps)" Style="{StaticResource SubHeadline}" />
                        <Grid RowSpacing="8" ColumnSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Text="Unit" VerticalOptions="Center" />
                            <Entry Grid.Row="0" Grid.Column="1"
                                   Text="{Binding Unit}"
                                   Placeholder="PV1.3.1 Unit" />

                            <Label Grid.Row="1" Grid.Column="0" Text="Room" VerticalOptions="Center" />
                            <Entry Grid.Row="1" Grid.Column="1"
                                   Text="{Binding Room}"
                                   Placeholder="PV1.3.2 Room" />

                            <Label Grid.Row="2" Grid.Column="0" Text="Bed" VerticalOptions="Center" />
                            <Entry Grid.Row="2" Grid.Column="1"
                                   Text="{Binding Bed}"
                                   Placeholder="PV1.3.3 Bed" />

                            <Label Grid.Row="3" Grid.Column="0" Text="Floor" VerticalOptions="Center" />
                            <Entry Grid.Row="3" Grid.Column="1"
                                   Text="{Binding Floor}"
                                   Placeholder="PV1.3.4 Floor" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ── Parameters ────────────────────────────────────────────── -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Parameters" Style="{StaticResource SubHeadline}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Patients" FontSize="13" />
                                <Entry Text="{Binding PatientCount}"
                                       Keyboard="Numeric"
                                       Placeholder="10" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Delay (ms)" FontSize="13" />
                                <Entry Text="{Binding GlobalDelayMs}"
                                       Keyboard="Numeric"
                                       Placeholder="500" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ── Start / Stop ──────────────────────────────────────────── -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Grid.Column="0"
                            Text="▶ Start"
                            Command="{Binding StartCommand}"
                            BackgroundColor="#10B981"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="44" />
                    <Button Grid.Column="1"
                            Text="■ Stop"
                            Command="{Binding StopCommand}"
                            BackgroundColor="#EF4444"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="44" />
                </Grid>

                <!-- ── Status ────────────────────────────────────────────────── -->
                <Border Style="{StaticResource CardBorder}"
                        IsVisible="{Binding StatusText, Converter={StaticResource StringNotEmptyConverter}}">
                    <Label Text="{Binding StatusText}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                           LineBreakMode="WordWrap" />
                </Border>

                <!-- ── Results ───────────────────────────────────────────────── -->
                <Border Style="{StaticResource CardBorder}"
                        IsVisible="{Binding Results, Converter={StaticResource CollectionNotEmptyConverter}}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Results" Style="{StaticResource SubHeadline}" />

                        <Label Text="{Binding SummaryText}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#1F2937, Dark=#F9FAFB}" />

                        <CollectionView ItemsSource="{Binding Results}"
                                        SelectionMode="None"
                                        HeightRequest="300">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8" Margin="0,2"
                                            StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#374151}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="4" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding .}"
                                               FontSize="12"
                                               FontFamily="Courier New, Courier, monospace"
                                               LineBreakMode="TailTruncation" />
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ── Footer ────────────────────────────────────────────────────────── -->
        <Grid Grid.Row="1"
              Padding="16,10"
              ColumnDefinitions="Auto,*,Auto"
              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

            <Button Grid.Column="0"
                    Text="Settings"
                    HorizontalOptions="Start"
                    Clicked="OnSettingsClicked" />

            <Label Grid.Column="1"
                   Text="Batch Send"
                   HorizontalOptions="Center"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource Primary}" />

            <Button Grid.Column="2"
                    Text="Home"
                    HorizontalOptions="End"
                    Clicked="OnHomeClicked" />
        </Grid>

    </Grid>

</ContentPage>
