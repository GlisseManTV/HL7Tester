<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HL7Tester.FhirConverterPage"
             xmlns:converters="clr-namespace:HL7Tester.Converters"
             Title="Converter">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Main layout: header + input (top), output (middle), footer (bottom) -->
    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ── Row 0: Header + direction toggle ─────────────────────────────── -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorder}"
                Margin="16,12,16,4">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">

                <Label Grid.Row="0"
                       Text="HL7 ⇄ FHIR Converter"
                       FontAttributes="Bold"
                       FontSize="17"
                       TextColor="{DynamicResource Primary}" />

                <!-- Direction toggle: active button colored, inactive gray -->
                <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            Text="HL7 → FHIR"
                            BackgroundColor="{Binding Hl7DirectionColor}"
                            TextColor="White"
                            FontAttributes="Bold"
                            Padding="12,8"
                            Clicked="OnHl7DirectionClicked" />
                    <Button Grid.Column="1"
                            Text="FHIR → HL7"
                            BackgroundColor="{Binding FhirDirectionColor}"
                            TextColor="White"
                            FontAttributes="Bold"
                            Padding="12,8"
                            Clicked="OnFhirDirectionClicked" />
                </Grid>

            </Grid>
        </Border>

        <!-- ── Row 1: Input card ────────────────────────────────────────────── -->
        <Border Grid.Row="1"
                Style="{StaticResource CardBorder}"
                Margin="16,4">
            <VerticalStackLayout Spacing="8">

                <Label Text="Input"
                       FontAttributes="Bold"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />

                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#374151}"
                        Padding="8,4">
                    <Border.GestureRecognizers>
                        <DropGestureRecognizer AllowDrop="True" Drop="OnInputFileDropped" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <Editor x:Name="InputEditor"
                            HeightRequest="140"
                            FontFamily="Courier New, Courier, monospace"
                            FontSize="11"
                            Placeholder="{Binding InputPlaceholder}"
                            Text="{Binding InputMessage}" />
                </Border>

            </VerticalStackLayout>
        </Border>

        <!-- ── Row 2: Output card (fills remaining space) ───────────────────── -->
        <Border Grid.Row="2"
                Style="{StaticResource CardBorder}"
                Margin="16,4">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">

                <Label Grid.Row="0"
                       Text="{Binding OutputLabel}"
                       FontAttributes="Bold"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />

                <!-- Status bar -->
                <Border Grid.Row="1"
                        Padding="10,6"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light=#F0FDF4, Dark=#14532D}"
                        IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <Label Text="{Binding StatusMessage}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#166534, Dark=#86EFAC}" />
                </Border>

                <Border Grid.Row="2"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#374151}"
                        Padding="8,4"
                        VerticalOptions="Fill">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <Editor x:Name="OutputEditor"
                            IsReadOnly="True"
                            AutoSize="Disabled"
                            FontFamily="Courier New, Courier, monospace"
                            FontSize="11"
                            Placeholder="Converted output appears here"
                            Text="{Binding OutputMessage}" />
                </Border>

            </Grid>
        </Border>

        <!-- ── Row 3: Static footer with action buttons ─────────────────────── -->
        <Grid Grid.Row="3"
              Padding="16,10"
              ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto"
              ColumnSpacing="6"
              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

            <Button Grid.Column="0"
                    Text="Settings"
                    Clicked="OnSettingsClicked" />

            <Button Grid.Column="1"
                    Text="Convert"
                    IsEnabled="{Binding IsNotBusy}"
                    Command="{Binding ConvertCommand}" />

            <Button Grid.Column="2"
                    Text="Swap"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray600}}"
                    Command="{Binding SwapDirectionCommand}" />

            <Button Grid.Column="3"
                    Text="Copy"
                    IsVisible="{Binding HasOutput}"
                    Command="{Binding CopyOutputCommand}" />

            <Button Grid.Column="4"
                    Text="Clear"
                    IsVisible="{Binding HasOutput}"
                    Command="{Binding ClearCommand}" />

            <Button Grid.Column="6"
                    Text="Send to Main"
                    IsVisible="{Binding HasOutput}"
                    Command="{Binding SendToMainPageCommand}" />

            <Button Grid.Column="7"
                    Text="Home"
                    HorizontalOptions="End"
                    Clicked="OnHomeClicked" />
        </Grid>

    </Grid>

</ContentPage>
