<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HL7Tester.NetworkSettingsPage"
             xmlns:controls="clr-namespace:HL7Tester.Controls"
             xmlns:converters="clr-namespace:HL7Tester.Resources.Converters"
             Title="Settings">

    <ContentPage.Resources>
        <converters:ProtocolDisplayConverter x:Key="ProtocolDisplayConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <!-- Scrollable content area -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="16">

                <!-- Active mode badge: purple = HL7v2, teal = FHIR -->
                <Border BackgroundColor="{Binding ModeBadgeColor}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 6"
                        Padding="12,6"
                        HorizontalOptions="Start">
                    <Label Text="{Binding ModeBadgeText}"
                           TextColor="White"
                           FontSize="13"
                           FontAttributes="Bold" />
                </Border>

                <!-- Migration notice: Connections moved to a dedicated page -->
                <Border Style="{StaticResource CardBorder}" Padding="16">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                            <Label Text="Network settings have moved" FontAttributes="Bold" FontSize="15" />
                            <Label Text="IP address, port and connection history are now managed in the Connections page."
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Open Connections"
                                Command="{Binding OpenConnectionsCommand}"
                                VerticalOptions="Center"
                                Padding="12,8" />
                    </Grid>
                </Border>

                <!-- Row 1: Application Settings (full width) -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Application Settings" Style="{StaticResource SubHeadline}" />
                        <Grid RowSpacing="10" ColumnSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Text="Protocol" VerticalOptions="Center" />
                            <controls:AppDropdown Grid.Row="0" Grid.Column="1"
                                    ItemsSource="{Binding AvailableProtocols}"
                                    SelectedItem="{Binding SelectedProtocol}"
                                    DisplayConverter="{StaticResource ProtocolDisplayConverter}" />

                            <Label Grid.Row="1" Grid.Column="0" Text="Check updates" VerticalOptions="Center" />
                            <Switch Grid.Row="1" Grid.Column="1"
                                    IsToggled="{Binding AutoUpdateCheck}" />

                            <Label Grid.Row="2" Grid.Column="0" Text="Log level" VerticalOptions="Center" />
                            <controls:AppDropdown Grid.Row="2" Grid.Column="1"
                                    ItemsSource="{Binding AvailableLogLevels}"
                                    SelectedItem="{Binding SelectedLogLevel}" />

                            <Label Grid.Row="3" Grid.Column="0" Text="Message encoding" VerticalOptions="Center" />
                            <controls:AppDropdown Grid.Row="3" Grid.Column="1"
                                    ItemsSource="{Binding AvailableEncodings}"
                                    SelectedItem="{Binding SelectedEncoding}" />

                            <Grid Grid.Row="4" Grid.ColumnSpan="2"
                                  ColumnDefinitions="Auto,*"
                                  IsVisible="{Binding UseCustomEncoding}">
                                <Label Text="Use custom encoding" VerticalOptions="Center" />
                                <Switch Grid.Column="1"
                                        HorizontalOptions="End"
                                        IsToggled="{Binding UseCustomEncoding}" />
                            </Grid>

                            <Entry Grid.Row="5" Grid.ColumnSpan="2"
                                   Text="{Binding CustomEncoding}"
                                   Placeholder="e.g., ISO-8859-2, KOI8-R..."
                                   IsVisible="{Binding UseCustomEncoding}" />

                            <Button Grid.Row="6" Grid.ColumnSpan="2"
                                    Text="Save Application settings"
                                    Command="{Binding SaveApplicationSettingsCommand}"
                                    HorizontalOptions="Fill" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Row 3: Documentation (left) + HL7 Tools (right) -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    
                    <!-- Carte Documentation HL7 -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="HL7 Documentation" Style="{StaticResource SubHeadline}" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Button Grid.Column="0"
                                        Text="ADT v2.3 ↗"
                                        Command="{Binding OpenDocumentationCommand}"
                                        HorizontalOptions="Fill"
                                        Padding="8,6"
                                        FontSize="11" />
                                <Button Grid.Column="1"
                                        Text="ORM v2.3 ↗"
                                        Command="{Binding OpenOrmDocumentationCommand}"
                                        HorizontalOptions="Fill"
                                        Padding="8,6"
                                        FontSize="11" />
                                <Button Grid.Column="2"
                                        Text="SIU v2.3 ↗"
                                        Command="{Binding OpenSiuDocumentationCommand}"
                                        HorizontalOptions="Fill"
                                        Padding="8,6"
                                        FontSize="11" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Carte HL7 Tools -->
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="12">                        
                            <Label Text="HL7 Tools" Style="{StaticResource SubHeadline}" />
                            <Grid RowDefinitions="*,*,*" RowSpacing="8">
                                <Button Grid.Row="0"
                                        Text="Embedded HL7 Inspector"
                                        Command="{Binding OpenInspectorCommand}"
                                        HorizontalOptions="Fill"
                                        Padding="12,8" />
                                <Button Grid.Row="1"
                                        Text="Web based HL7 Inspector ↗"
                                        Command="{Binding OpenInspectorWebCommand}"
                                        HorizontalOptions="Fill"
                                        Padding="12,8" />
                                <Button Grid.Row="2"
                                        Text="Batch Send"
                                        Command="{Binding OpenBatchSendCommand}"
                                        HorizontalOptions="Fill"
                                        Padding="12,8" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Static footer with Home button only -->
        <Grid Grid.Row="1" Padding="16,10" ColumnDefinitions="*,Auto" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">
            <Label Grid.Column="0"
                   Text="{Binding AssemblyVersion}"
                   HorizontalOptions="Start"
                   FontSize="14"
                   TextColor="{DynamicResource Primary}" />

            <Button Grid.Column="1"
                    Text="Home"
                    HorizontalOptions="End"
                    Clicked="OnHomeClicked" />
        </Grid>

    </Grid>

</ContentPage>